# Laurel defaults tuned for the onboard ICM42688P sensor stack.
#
# Scheduler rate: live tasks.txt profiling (2025-04 debug build) shows
# FAST_TASK functions alone consume ~7500 us/loop:
#   read_AHRS      AVG=5226 us  (65.7% CPU — EKF3 dominates)
#   update_flight_mode AVG=1566 us  (20.1%)
# At 400 Hz the budget is 2500 us — 3x over, so the loop only hits ~114 Hz
# and GCS::update_send (AVG=1100 us, OVR=999) is perpetually starved.
# At 200 Hz the budget is 5000 us — still tight for debug, but leaves
# headroom for GCS, logging, and IO tasks.  For release builds (-O2)
# EKF drops to ~500 us and 400 Hz should be achievable; revisit then.
SCHED_LOOP_RATE 200
INS_FAST_SAMPLE 1
FSTRATE_ENABLE 1

# Enable watchdog by default.
BRD_OPTIONS 1

# Quad-X frame with 4 motors (matches the 4 PWM outputs on GPIO28-31).
FRAME_CLASS 1
FRAME_TYPE 1

# Battery scaling values need Laurel hardware calibration.
#BATT_AMP_PERVLT 1.0
#BATT_VOLT_MULT 1.0