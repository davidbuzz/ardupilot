# Conservative Laurel defaults for RP2350 bring-up.

# Keep loop rate conservative until the RP2350 Laurel target has seen runtime
# validation with its real sensor stack.
SCHED_LOOP_RATE 100
INS_FAST_SAMPLE 0
FSTRATE_ENABLE 0

# Enable watchdog by default.
BRD_OPTIONS 1

# Battery scaling values need Laurel hardware calibration.
#BATT_AMP_PERVLT 1.0
#BATT_VOLT_MULT 1.0