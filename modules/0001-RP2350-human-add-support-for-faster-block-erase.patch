From 3fc6eb1983cdd2d1c78e7696c726427ded64fda0 Mon Sep 17 00:00:00 2001
From: David Buzz <davidbuzz@gmail.com>
Date: Sun, 15 Mar 2026 10:16:12 +1000
Subject: [PATCH] RP2350 - human - add support for faster block erase

---
 os/hal/ports/RP/RP2350/hal_efl_lld.c | 68 ++++++++++++++++++++++++++++
 os/hal/ports/RP/RP2350/hal_efl_lld.h |  2 +
 2 files changed, 70 insertions(+)

diff --git a/os/hal/ports/RP/RP2350/hal_efl_lld.c b/os/hal/ports/RP/RP2350/hal_efl_lld.c
index 27ee9538c4..fdd81f0d33 100644
--- a/os/hal/ports/RP/RP2350/hal_efl_lld.c
+++ b/os/hal/ports/RP/RP2350/hal_efl_lld.c
@@ -114,6 +114,7 @@
 #define FLASHCMD_READ_STATUS                0x05U
 #define FLASHCMD_PAGE_PROGRAM               0x02U
 #define FLASHCMD_SECTOR_ERASE               0x20U
+#define FLASHCMD_BLOCK_ERASE                0xD8U  /* 64KB block erase - ~8x faster than 16 sector erases */
 #define FLASHCMD_READ_UNIQUE_ID             0x4BU
 /** @} */
 
@@ -510,6 +511,37 @@ RAMFUNC static void rp_flash_erase_sector_full(EFlashDriver *eflp,
   rp_flash_enter_xip(eflp);
 }
 
+/**
+ * @brief   Complete 64KB block erase operation (runs entirely in RAM).
+ * @note    This function MUST be in RAM. Uses the BLOCK ERASE (0xD8) command
+ *          which erases 64KB at a time, ~8x faster than 16 individual sector
+ *          erases when erasing large regions.
+ *
+ * @param[in] eflp      pointer to the EFlashDriver object
+ * @param[in] offset    flash offset (must be 64KB-aligned)
+ */
+RAMFUNC static void rp_flash_erase_block_full(EFlashDriver *eflp,
+                                              uint32_t offset) {
+  uint8_t addr[3];
+
+  addr[0] = (uint8_t)(offset >> 16);
+  addr[1] = (uint8_t)(offset >> 8);
+  addr[2] = (uint8_t)offset;
+
+  /* Exit XIP mode. */
+  rp_flash_exit_xip(eflp);
+
+  /* Send write enable + 64KB block erase command. */
+  rp_flash_write_enable(eflp);
+  rp_flash_do_cmd(eflp, FLASHCMD_BLOCK_ERASE, addr, NULL, 3U);
+
+  /* Wait for erase to complete. */
+  rp_flash_wait_ready(eflp);
+
+  /* Re-enter XIP mode. */
+  rp_flash_enter_xip(eflp);
+}
+
 /**
  * @brief   Single-page program operation that runs entirely in RAM.
  * @note    This function MUST be in RAM. It handles the entire sequence
@@ -791,6 +823,42 @@ flash_error_t efl_lld_start_erase_sector(void *instance,
   return FLASH_NO_ERROR;
 }
 
+/**
+ * @brief   Starts a 64KB block erase operation (faster bulk erase).
+ * @note    Uses BLOCK ERASE (0xD8) - erases 64KB at once, ~8x faster than
+ *          16 individual 4KB sector erases.  Offset must be 64KB-aligned.
+ *
+ * @param[in] instance  pointer to a @p EFlashDriver instance
+ * @param[in] offset    flash offset (must be a multiple of 65536)
+ * @return              An error code.
+ * @retval FLASH_NO_ERROR           if the block erase completed.
+ * @retval FLASH_BUSY_ERASING       if there is an erase operation in progress.
+ *
+ * @notapi
+ */
+flash_error_t efl_lld_start_erase_block(void *instance, flash_offset_t offset) {
+  EFlashDriver *devp = (EFlashDriver *)instance;
+  syssts_t sts;
+
+  osalDbgCheck(instance != NULL);
+  osalDbgAssert((devp->state == FLASH_READY) || (devp->state == FLASH_ERASE),
+                "invalid state");
+
+  if (devp->state == FLASH_ERASE) {
+    return FLASH_BUSY_ERASING;
+  }
+
+  devp->state = FLASH_ERASE;
+
+  sts = osalSysGetStatusAndLockX();
+  rp_flash_erase_block_full(devp, offset);
+  osalSysRestoreStatusX(sts);
+
+  devp->state = FLASH_READY;
+
+  return FLASH_NO_ERROR;
+}
+
 /**
  * @brief   Queries the driver for erase operation progress.
  *
diff --git a/os/hal/ports/RP/RP2350/hal_efl_lld.h b/os/hal/ports/RP/RP2350/hal_efl_lld.h
index 39f6f37667..9b4ddd6f35 100644
--- a/os/hal/ports/RP/RP2350/hal_efl_lld.h
+++ b/os/hal/ports/RP/RP2350/hal_efl_lld.h
@@ -150,6 +150,8 @@ extern "C" {
   flash_error_t efl_lld_start_erase_all(void *instance);
   flash_error_t efl_lld_start_erase_sector(void *instance,
                                            flash_sector_t sector);
+  flash_error_t efl_lld_start_erase_block(void *instance,
+                                          flash_offset_t offset);
   flash_error_t efl_lld_query_erase(void *instance, uint32_t *wait_time);
   flash_error_t efl_lld_verify_erase(void *instance, flash_sector_t sector);
   void efl_lld_read_unique_id(EFlashDriver *eflp, uint8_t *uid);
-- 
2.43.0

