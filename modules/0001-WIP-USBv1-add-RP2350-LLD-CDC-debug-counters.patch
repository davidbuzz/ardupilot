From 6d2ebd89ae2b574c8f5b11706bba52b0ebf434b7 Mon Sep 17 00:00:00 2001
From: David Buzz <davidbuzz@gmail.com>
Date: Wed, 1 Apr 2026 08:33:48 +1000
Subject: [PATCH] WIP: USBv1 add RP2350 LLD CDC debug counters

---
 os/hal/ports/RP/LLD/USBv1/hal_usb_lld.c | 26 +++++++++++++++++++++++++
 1 file changed, 26 insertions(+)

diff --git a/os/hal/ports/RP/LLD/USBv1/hal_usb_lld.c b/os/hal/ports/RP/LLD/USBv1/hal_usb_lld.c
index 3357e03f65..fc981cfb41 100644
--- a/os/hal/ports/RP/LLD/USBv1/hal_usb_lld.c
+++ b/os/hal/ports/RP/LLD/USBv1/hal_usb_lld.c
@@ -53,6 +53,18 @@
  */
 #if (RP_USB_USE_USB1 == TRUE) || defined(__DOXYGEN__)
 USBDriver USBD1;
+
+/*
+ * Live USB LLD diagnostics for GDB/OpenOCD inspection during RP2350 CDC
+ * completion debugging. These are intentionally simple globals so they can be
+ * sampled without relying on the USB console being functional.
+ */
+volatile uint32_t usb_lld_irq_count;
+volatile uint32_t usb_lld_buff_status_irq_count;
+volatile uint32_t usb_lld_last_ints;
+volatile uint32_t usb_lld_last_buf_status;
+volatile uint32_t usb_lld_ep1_in_complete_count;
+volatile uint32_t usb_lld_ep1_out_complete_count;
 #endif
 
 /*===========================================================================*/
@@ -337,6 +349,11 @@ static void usb_serve_endpoint(USBDriver *usbp, usbep_t ep, bool is_in) {
   uint16_t n;
 
   if (is_in) {
+#if RP_USB_USE_USB1 == TRUE
+    if (ep == 1U) {
+      usb_lld_ep1_in_complete_count++;
+    }
+#endif
     /* IN endpoint */
     iesp = usbp->epc[ep]->in_state;
 
@@ -351,6 +368,11 @@ static void usb_serve_endpoint(USBDriver *usbp, usbep_t ep, bool is_in) {
       _usb_isr_invoke_in_cb(usbp, ep);
     }
   } else {
+#if RP_USB_USE_USB1 == TRUE
+    if (ep == 1U) {
+      usb_lld_ep1_out_complete_count++;
+    }
+#endif
     /* OUT endpoint */
     oesp = usbp->epc[ep]->out_state;
 
@@ -393,10 +415,14 @@ static void usb_lld_serve_interrupt(USBDriver *usbp) {
   uint32_t ints;
 
   ints = USB->INTS;
+  usb_lld_irq_count++;
+  usb_lld_last_ints = ints;
 
   /* Endpoint events handling. */
   if (ints & USB_INTS_BUFF_STATUS) {
     uint32_t buf_status = USB->BUFSTATUS;
+    usb_lld_buff_status_irq_count++;
+    usb_lld_last_buf_status = buf_status;
     uint32_t bit = 1U;
     for (uint8_t i = 0; buf_status && i < 32; i++) {
       if (buf_status & bit) {
-- 
2.43.0

