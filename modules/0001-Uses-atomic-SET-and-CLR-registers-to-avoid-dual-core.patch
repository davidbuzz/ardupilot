From e5939baadd88187e5c65e83387ac8adbe3904419 Mon Sep 17 00:00:00 2001
From: David Buzz <davidbuzz@gmail.com>
Date: Mon, 16 Mar 2026 06:56:03 +1000
Subject: [PATCH] Uses atomic SET and CLR registers to avoid dual-core
 TIMER0->INTE races.

---
 os/hal/ports/RP/LLD/TIMERv1/hal_st_lld.h | 22 +++++++++++++++++-----
 1 file changed, 17 insertions(+), 5 deletions(-)

diff --git a/os/hal/ports/RP/LLD/TIMERv1/hal_st_lld.h b/os/hal/ports/RP/LLD/TIMERv1/hal_st_lld.h
index 3c0425a0f4..ca3565cb89 100644
--- a/os/hal/ports/RP/LLD/TIMERv1/hal_st_lld.h
+++ b/os/hal/ports/RP/LLD/TIMERv1/hal_st_lld.h
@@ -177,6 +177,8 @@ __STATIC_INLINE systime_t st_lld_get_counter(void) {
  * @brief   Starts the alarm.
  * @note    Makes sure that no spurious alarms are triggered after
  *          this call.
+ * @note    Uses atomic SET register to avoid dual-core TIMER0->INTE races.
+ * @note    Recovers from missed alarm (abstime already past) by re-arming.
  *
  * @param[in] abstime   the time to be set for the first alarm
  *
@@ -186,17 +188,23 @@ __STATIC_INLINE void st_lld_start_alarm(systime_t abstime) {
 
   TIMER0->ALARM[0]       = (uint32_t)abstime;
   TIMER0->INTR           = (1U << 0);
-  TIMER0->INTE          |= (1U << 0);
+  TIMER0->SET.INTE       = (1U << 0);  /* Atomic set - safe on dual-core RP2350.*/
+  /* If the alarm value was already past when armed (ARMED cleared immediately),
+   * re-arm to fire in 2 ticks to avoid waiting for 32-bit counter wrap (~71min).*/
+  if ((TIMER0->ARMED & (1U << 0)) == 0U) {
+    TIMER0->ALARM[0]     = TIMER0->TIMERAWL + 2U;
+  }
 }
 
 /**
  * @brief   Stops the alarm interrupt.
+ * @note    Uses atomic CLR register to avoid dual-core TIMER0->INTE races.
  *
  * @notapi
  */
 __STATIC_INLINE void st_lld_stop_alarm(void) {
 
-  TIMER0->INTE          &= ~(1U << 0);
+  TIMER0->CLR.INTE       = (1U << 0);  /* Atomic clear - safe on dual-core RP2350.*/
 }
 
 /**
@@ -252,10 +260,14 @@ __STATIC_INLINE bool st_lld_is_alarm_active(void) {
  */
 __STATIC_INLINE void st_lld_start_alarm_n(unsigned alarm, systime_t abstime) {
 
-
   TIMER0->ALARM[alarm]   = (uint32_t)abstime;
   TIMER0->INTR           = (1U << alarm);
-  TIMER0->INTE          |= (1U << alarm);
+  TIMER0->SET.INTE       = (1U << alarm);  /* Atomic set - safe on dual-core RP2350.*/
+  /* If the alarm value was already past when armed (ARMED cleared immediately),
+   * re-arm to fire in 2 ticks to avoid waiting for 32-bit counter wrap (~71min).*/
+  if ((TIMER0->ARMED & (1U << alarm)) == 0U) {
+    TIMER0->ALARM[alarm] = TIMER0->TIMERAWL + 2U;
+  }
 }
 
 /**
@@ -269,7 +281,7 @@ __STATIC_INLINE void st_lld_start_alarm_n(unsigned alarm, systime_t abstime) {
  */
 __STATIC_INLINE void st_lld_stop_alarm_n(unsigned alarm) {
 
-  TIMER0->INTE          &= ~(1U << alarm);
+  TIMER0->CLR.INTE       = (1U << alarm);  /* Atomic clear - safe on dual-core RP2350.*/
 }
 
 /**
