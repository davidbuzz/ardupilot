From 59ff1c37c4b4974bd66e2a90540d01644f62c1d9 Mon Sep 17 00:00:00 2001
From: David 'Buzz' Bussenschutt <d.bussenschutt@uq.edu.au>
Date: Sun, 15 Mar 2026 07:37:38 +1000
Subject: [PATCH] RP2350: USB ISR fix BUS_RESET before SETUP_REQ ordering
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

When both BUS_RESET and SETUP_REQ accumulate in USB->INTS
simultaneously—which happens when a previous SETUP packet was
unanswered (USB ISR delayed) and the host then issues a new
PORT_RESET—the old code processed SETUP_REQ first, queued the
GET_DESCRIPTOR response, and then BUS_RESET called _usb_reset()
which immediately destroyed that response.  The host never received
the device descriptor, enumeration failed, and the port was reset
every ~5s indefinitely.

Fix: process BUS_RESET before SETUP_REQ.  A bus reset invalidates
any in-progress control transfer; handling it first ensures EP0 is
in a clean state before any incoming SETUP packet is processed.
---
 os/hal/ports/RP/LLD/USBv1/hal_usb_lld.c | 20 +++++++++++++-------
 1 file changed, 13 insertions(+), 7 deletions(-)

diff --git a/os/hal/ports/RP/LLD/USBv1/hal_usb_lld.c b/os/hal/ports/RP/LLD/USBv1/hal_usb_lld.c
index d8f37d626f..3357e03f65 100644
--- a/os/hal/ports/RP/LLD/USBv1/hal_usb_lld.c
+++ b/os/hal/ports/RP/LLD/USBv1/hal_usb_lld.c
@@ -411,6 +411,19 @@ static void usb_lld_serve_interrupt(USBDriver *usbp) {
     }
   }
 
+  /* USB bus reset condition handling.
+   * Must be processed BEFORE SETUP_REQ: if both BUS_RESET and SETUP_REQ
+   * accumulate in USB->INTS (e.g. when a previous SETUP was unanswered and
+   * the host issued a new PORT_RESET), handling SETUP first queues a
+   * descriptor response and then _usb_reset() immediately destroys it,
+   * so enumeration never succeeds.  Clearing the reset state first ensures
+   * any following SETUP packet is handled on a clean EP0. */
+  if (ints & USB_INTS_BUS_RESET) {
+    USB->CLR.SIESTATUS = USB_SIE_STATUS_BUS_RESET;
+
+    _usb_reset(usbp);
+  }
+
   /* USB setup packet handling. */
   if (ints & USB_INTS_SETUP_REQ) {
     USB->CLR.SIESTATUS = USB_SIE_STATUS_SETUP_REC;
@@ -420,13 +433,6 @@ static void usb_lld_serve_interrupt(USBDriver *usbp) {
     _usb_isr_invoke_setup_cb(usbp, 0);
   }
 
-  /* USB bus reset condition handling. */
-  if (ints & USB_INTS_BUS_RESET) {
-    USB->CLR.SIESTATUS = USB_SIE_STATUS_BUS_RESET;
-
-    _usb_reset(usbp);
-  }
-
   /* USB bus SUSPEND condition handling.*/
   if (ints & USB_INTS_DEV_SUSPEND) {
     USB->CLR.SIESTATUS = USB_SIE_STATUS_SUSPENDED;
-- 
